	"narrative": {
		"northStar": "The Binder",
		"overview": "DevCodex treats every software engineering concept as a collectible trading card. Finishing an article opens a pack, and the trivia deck is your binder. The world comes from card binders and collectible sets: felt-dark sleeves, numbered cards with a level and a rarity, and saturated track colours that fill whole surfaces instead of tinting small accents. That energy belongs to the frame. Inside an article, the reading column stays calm, with a hyperlegible reading face at a real measure, so the binder rewards learning without competing with it.",
		"keyCharacteristics": [
			"A near-black binder-felt ground with three saturated track fields: Web ember, Code violet and Data teal.",
			"Numbered 5:7 concept cards with a track-colour frame, a per-concept line drawing, level pips and a collector number.",
			"Gold is the colour of reward: selection, new cards, collected counts, rares.",
			"Chunky rounded geometry: pills for actions, 16–28px radii for cards and panels.",
			"One ritual per surface: pack opening, the swipe deck, the auto-playing short."
		],
		"rules": [
			{
				"name": "The Track Owns The Field Rule",
				"body": "A track colour fills a region (`--t` on the region, `--t-ink` for everything on top of it), or it does not appear. Never use it as a thin stripe or a tint on grey.",
				"section": "colors"
			},
			{
				"name": "The Gold Means Earned Rule",
				"body": "Gold marks what the learner selected, collected or unlocked. Do not use it as a generic accent.",
				"section": "colors"
			},
			{
				"name": "The Level Frames The Lesson Rule",
				"body": "A level colour (entry green, experienced blue, senior red) appears only as a full 2px frame around a lesson and as its tag. Never as a fill, a stripe or a decoration elsewhere.",
				"section": "colors"
			},
			{
				"name": "The Mono Is For Machines Rule",
